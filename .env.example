# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
NLI_MODEL=roberta-large-mnli

# Retrieval Configuration
BM25_K1=1.5
BM25_B=0.75
TOP_K_RETRIEVAL=30
TOP_K_RERANK=10
FUSION_ALPHA=0.5

# Generation Configuration
MAX_TOKENS=1500
TEMPERATURE=0.1
MIN_CONFIDENCE=0.0
ABSTENTION_THRESHOLD=0.3

# OpenAI Generation
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.1

# Paths
DATA_PATH=./data
MODEL_PATH=./models
INDEX_PATH=./data/indices

# If using OpenAI for generation (ENABLED for research quality)
USE_OPENAI_GENERATOR=true
OPENAI_API_KEY=your-openai-api-key-here
# https://platform.openai.com/api-keys

# If using local LLM (no API key needed) - NOT RECOMMENDED for research
# USE_OPENAI_GENERATOR=false
